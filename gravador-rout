local FOLDER = "DripRotas"
local canFS = (writefile and readfile and isfile and makefolder and isfolder and listfiles) and true or false

local function ensureFolder()
    if not canFS then return end
    pcall(function()
        if not isfolder(FOLDER) then makefolder(FOLDER) end
    end)
end

local function safeName(name)
    local s = tostring(name):gsub("[^%w_%-]", "_")
    if s == "" then s = "rota" end
    return s
end

local function rnd(n, d)
    local m = 10 ^ d
    return math.floor(n * m + 0.5) / m
end

local function compress(data)
    local out = table.create(#data)
    for i, p in ipairs(data) do
        local cf = table.create(12)
        for k, v in ipairs(p.CF) do cf[k] = rnd(v, 5) end
        local anims = {}
        for _, a in ipairs(p.Animations or {}) do
            table.insert(anims, {
                Id = a.Id,
                Speed = rnd(a.Speed or 1, 3),
                Weight = rnd(a.Weight or 1, 3),
                Priority = a.Priority,
            })
        end
        out[i] = {
            Time = rnd(p.Time, 4),
            CF = cf,
            Velocity = { rnd(p.Velocity[1], 3), rnd(p.Velocity[2], 3), rnd(p.Velocity[3], 3) },
            State = p.State,
            Animations = anims,
        }
    end
    return out
end

local KEY = "dR1p#angel!7Xq29vK"
local ALPHA = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local ENC, DEC = {}, {}
for i = 1, #ALPHA do
    local ch = ALPHA:sub(i, i)
    ENC[i - 1] = ch
    DEC[ch] = i - 1
end

local function encode(str)
    local n, kl = #str, #KEY
    local bytes = table.create(n)
    for i = 1, n do
        bytes[i] = bit32.bxor(string.byte(str, i), string.byte(KEY, (i - 1) % kl + 1), (i * 7) % 256)
    end
    local out = {}
    for i = 1, n, 3 do
        local a, b, c = bytes[i], bytes[i + 1], bytes[i + 2]
        local v = a * 65536 + (b or 0) * 256 + (c or 0)
        local piece = ENC[math.floor(v / 262144) % 64] .. ENC[math.floor(v / 4096) % 64]
        piece = piece .. (b and ENC[math.floor(v / 64) % 64] or "=") .. (c and ENC[v % 64] or "=")
        out[#out + 1] = piece
    end
    return "DRIP1" .. table.concat(out)
end

local function decode(raw)
    if raw:sub(1, 5) ~= "DRIP1" then return nil end
    raw = raw:sub(6)
    local kl = #KEY
    local bytes, count = {}, 0
    for i = 1, #raw, 4 do
        local c1, c2 = DEC[raw:sub(i, i)], DEC[raw:sub(i + 1, i + 1)]
        local c3, c4 = DEC[raw:sub(i + 2, i + 2)], DEC[raw:sub(i + 3, i + 3)]
        if not c1 or not c2 then break end
        local v = c1 * 262144 + c2 * 4096 + (c3 or 0) * 64 + (c4 or 0)
        count = count + 1
        bytes[count] = math.floor(v / 65536) % 256
        if c3 then count = count + 1 bytes[count] = math.floor(v / 256) % 256 end
        if c4 then count = count + 1 bytes[count] = v % 256 end
    end
    local chars = {}
    for i = 1, count do
        chars[i] = string.char(bit32.bxor(bytes[i], string.byte(KEY, (i - 1) % kl + 1), (i * 7) % 256))
    end
    local parts = {}
    for i = 1, count, 4096 do
        parts[#parts + 1] = table.concat(chars, "", i, math.min(i + 4095, count))
    end
    return table.concat(parts)
end

local savedRoutes = {}

local function saveToDisk(name, entry)
    if not canFS then return false end
    ensureFolder()
    local ok = pcall(function()
        local json = HttpService:JSONEncode({
            Name = name,
            Duracao = entry.Duracao,
            Pontos = entry.Pontos,
            Data = compress(entry.Data),
        })
        writefile(entry.File, encode(json))
    end)
    return ok
end

local function deleteFromDisk(entry)
    if not canFS or not entry.File then return end
    pcall(function()
        if delfile and isfile(entry.File) then delfile(entry.File) end
    end)
end

local function loadAllFromDisk()
    if not canFS then return 0 end
    ensureFolder()
    local count = 0
    local ok, files = pcall(function() return listfiles(FOLDER) end)
    if not ok or type(files) ~= "table" then return 0 end
    for _, path in ipairs(files) do
        if tostring(path):sub(-5) == ".drip" then
            pcall(function()
                local plain = decode(readfile(path))
                if not plain then return end
                local decoded = HttpService:JSONDecode(plain)
                if type(decoded) == "table" and type(decoded.Data) == "table" and #decoded.Data > 0 then
                    local name = decoded.Name or tostring(path):match("([^/\\]+)%.drip$") or "rota"
                    local base, n = name, 2
                    while savedRoutes[name] do
                        name = base .. "_" .. n
                        n = n + 1
                    end
                    savedRoutes[name] = {
                        Duracao = decoded.Duracao or 0,
                        Pontos = decoded.Pontos or #decoded.Data,
                        Data = decoded.Data,
                        File = path,
                    }
                    count = count + 1
                end
            end)
        end
    end
    return count
end

