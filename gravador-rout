track(RecordBtn.MouseButton1Click:Connect(function()
    if playbackConnection then stopPlayback() end
    isRecording = not isRecording

    if isRecording then
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if not hrp or not hum then
            isRecording = false
            setStatus("Sem personagem", "warn")
            return
        end

        recordedData = {}
        startTime = os.clock()
        startTimer()
        RecordBtn.Text = "Parar"
        RecordBtn.BackgroundColor3 = C.Red
        setStatus("Gravando...", "rec")

        recordingConnection = RunService.Heartbeat:Connect(function()
            local currentTime = os.clock() - startTime
            local cf = hrp.CFrame
            local vel = hrp.AssemblyLinearVelocity
            local state = hum:GetState()
            local anims = {}
            local animator = hum:FindFirstChildOfClass("Animator")
            if animator then
                for _, trackObj in ipairs(animator:GetPlayingAnimationTracks()) do
                    if trackObj.Animation and trackObj.WeightCurrent > 0.01 then
                        table.insert(anims, {
                            Id = trackObj.Animation.AnimationId,
                            Speed = trackObj.Speed,
                            Weight = trackObj.WeightCurrent,
                            Priority = trackObj.Priority.Name,
                        })
                    end
                end
            end
            table.insert(recordedData, {
                Time = currentTime,
                CF = { cf:GetComponents() },
                Velocity = { vel.X, vel.Y, vel.Z },
                State = state.Name,
                Animations = anims,
            })
        end)
    else
        if recordingConnection then
            recordingConnection:Disconnect()
            recordingConnection = nil
        end
        stopTimer()
        resetRecordButton()
        setStatus(string.format("%.2fs  |  %d pontos", timerFrozen, #recordedData), "ok")
    end
end))

