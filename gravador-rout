refreshDataList = function()
    for _, child in ipairs(DataScroll:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextLabel") then child:Destroy() end
    end
    local names = {}
    for n in pairs(savedRoutes) do table.insert(names, n) end
    table.sort(names)

    CountLabel.Text = string.format("%d rota(s)%s", #names, canFS and "  |  salvas no aparelho" or "  |  só nesta sessão")

    if #names == 0 then
        new("TextLabel", {
            Size = UDim2.new(1, 0, 0, 60),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Text = "Nenhuma rota salva\nGrave uma rota e toque em Salvar rota",
            TextColor3 = C.TextDim,
            TextSize = 11,
            TextWrapped = true,
        }, DataScroll)
        return
    end

    for i, name in ipairs(names) do
        local entry = savedRoutes[name]

        local item = new("Frame", {
            Size = UDim2.new(1, -4, 0, 64),
            BackgroundColor3 = C.Bg2,
            BorderSizePixel = 0,
            LayoutOrder = i,
        }, DataScroll)
        corner(item, 8)
        stroke(item, C.Bg3, 1)

        new("TextLabel", {
            Size = UDim2.new(1, -14, 0, 15),
            Position = UDim2.new(0, 7, 0, 5),
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamBold,
            Text = name,
            TextColor3 = C.Text,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, item)

        new("TextLabel", {
            Size = UDim2.new(1, -14, 0, 12),
            Position = UDim2.new(0, 7, 0, 20),
            BackgroundTransparency = 1,
            Font = Enum.Font.Code,
            Text = string.format("%.2fs  |  %d pontos", entry.Duracao, entry.Pontos),
            TextColor3 = C.AccentHi,
            TextSize = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, item)

        local row = new("Frame", {
            Size = UDim2.new(1, -14, 0, 22),
            Position = UDim2.new(0, 7, 0, 36),
            BackgroundTransparency = 1,
        }, item)

        local function rowBtn(text, color, index, onClick)
            local b = new("TextButton", {
                Size = UDim2.new(1 / 2, -3, 1, 0),
                Position = UDim2.new((index - 1) / 2, (index - 1) * 3, 0, 0),
                BackgroundColor3 = color,
                Font = Enum.Font.GothamBold,
                Text = text,
                TextColor3 = C.Text,
                TextSize = 10,
                BorderSizePixel = 0,
                AutoButtonColor = true,
            }, row)
            corner(b, 6)
            track(b.MouseButton1Click:Connect(function() onClick(b) end))
            return b
        end

        rowBtn("Testar", C.AccentDark, 1, function()
            if isRecording then setStatus("Pare a gravação antes", "warn") return end
            MainFrame.Visible = true
            playRoute(entry.Data)
        end)

        local confirmAt = 0
        rowBtn("Apagar", Color3.fromRGB(150, 44, 60), 2, function(btn)
            if os.clock() - confirmAt < 2.5 then
                deleteFromDisk(entry)
                savedRoutes[name] = nil
                setStatus("Apagada: " .. name, "warn")
                refreshDataList()
            else
                confirmAt = os.clock()
                btn.Text = "Certeza?"
                task.delay(2.5, function()
                    if btn and btn.Parent then btn.Text = "Apagar" end
                end)
            end
        end)
    end
end

